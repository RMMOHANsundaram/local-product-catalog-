# Copy this file to `.env` and adjust the values.

# MongoDB connection string.
#   Local MongoDB (with Compass):  mongodb://localhost:27017/
#   MongoDB Atlas cluster:         mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=mongodb://localhost:27017/

# Database name shown in MongoDB Compass.
MONGO_DB_NAME=local_product_catalog

# Flask session signing key — change this to a long random string.
SECRET_KEY=change-me-to-a-long-random-string
